# .env.example — copy this file to .env and fill in your values
# Never commit .env to version control

# ── Admin account (auto-created on first docker-compose up) ───
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── Alerting (optional) ───────────────────────────────────────
# Telegram: get your bot token from @BotFather, chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail SMTP (use a Gmail App Password, not your regular password)
# https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_PASS=

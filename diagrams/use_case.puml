@startuml use_case
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13

skinparam usecase {
  BackgroundColor #EEF2FF
  BorderColor #4F46E5
  FontColor #1e1b4b
  ArrowColor #4F46E5
}
skinparam actor {
  BackgroundColor white
  BorderColor #4F46E5
  FontColor #1e1b4b
}
skinparam rectangle {
  BackgroundColor white
  BorderColor #94A3B8
  FontColor #1e1b4b
}

left to right direction

actor "Finance\nEmployee" as User
actor "Admin"             as Admin

rectangle "Security Booster" {

  usecase "Register / Login"        as UC1
  usecase "Send Chat Message"       as UC2
  usecase "Upload Document"         as UC3
  usecase "Reset Conversation"      as UC4

  usecase "Toggle Pipeline Features" as UC5
  usecase "Select BERT Model"        as UC6
  usecase "View Security Logs"       as UC7
  usecase "Manage Users"             as UC8
  usecase "Configure SOC Alerts"     as UC9
  usecase "View Analytics Dashboard" as UC10
}

User  --> UC1
User  --> UC2
User  --> UC3
User  --> UC4

Admin --> UC1
Admin --> UC5
Admin --> UC6
Admin --> UC7
Admin --> UC8
Admin --> UC9
Admin --> UC10

@enduml
